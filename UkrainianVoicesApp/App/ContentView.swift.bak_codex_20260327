import SwiftUI
import AVFoundation

private let appGroup = "group.rhvoice.UkrainianVoices.shared"
private let defaults = UserDefaults(suiteName: appGroup) ?? .standard

struct ContentView: View {
    @AppStorage("rate", store: defaults) private var rate: Double = 0.5
    @AppStorage("volume", store: defaults) private var volume: Double = 1.0
    @AppStorage("speedMultiplier", store: defaults) private var speedMultiplier: Double = 1.0
    @AppStorage("sentencePause", store: defaults) private var sentencePause: Double = 0

    @State private var testText = "Привіт! Це тест українського голосу."
    @State private var isSpeaking = false

    private let synth = AVSpeechSynthesizer()

    var body: some View {
        VStack(alignment: .leading, spacing: 0) {
            Text("Ukrainian Voices")
                .font(.largeTitle).bold()
                .padding([.horizontal, .top])
                .padding(.bottom, 8)

            List {
                // MARK: Voices
                Section("Voices (uk-UA)") {
                    voiceRow("Anatol", id: "com.andriybutenko.RHVoiceUA.anatol", lang: "uk-UA")
                    voiceRow("Marianna", id: "com.andriybutenko.RHVoiceUA.marianna", lang: "uk-UA")
                    voiceRow("Natalia", id: "com.andriybutenko.RHVoiceUA.natalia", lang: "uk-UA")
                    voiceRow("Volodymyr", id: "com.andriybutenko.RHVoiceUA.volodymyr", lang: "uk-UA")
                }

                Section("Voices (en-US)") {
                    voiceRow("Alan", id: "com.andriybutenko.RHVoiceUA.alan", lang: "en-US")
                    voiceRow("Victoria", id: "com.andriybutenko.RHVoiceUA.victoria", lang: "en-US")
                }

                // MARK: Settings
                Section("Speech Rate") {
                    HStack {
                        Image(systemName: "tortoise").accessibilityHidden(true)
                        Slider(value: $rate, in: 0...1)
                            .accessibilityLabel("Speech rate")
                            .accessibilityValue(Text(String(format: "%.0f%%", rate * 100)))
                        Image(systemName: "hare").accessibilityHidden(true)
                    }
                    Text(String(format: "%.0f%%", rate * 100))
                        .font(.footnote).foregroundColor(.secondary)
                }

                Section("Volume") {
                    HStack {
                        Image(systemName: "speaker.fill").accessibilityHidden(true)
                        Slider(value: $volume, in: 0...1)
                            .accessibilityLabel("Volume")
                            .accessibilityValue(Text(String(format: "%.0f%%", volume * 100)))
                        Image(systemName: "speaker.wave.3.fill").accessibilityHidden(true)
                    }
                    Text(String(format: "%.0f%%", volume * 100))
                        .font(.footnote).foregroundColor(.secondary)
                }

                Section("Speed Multiplier") {
                    HStack {
                        Text("1x").accessibilityHidden(true)
                        Slider(value: $speedMultiplier, in: 1...5, step: 0.5)
                            .accessibilityLabel("Speed multiplier")
                            .accessibilityValue(Text(String(format: "%.1fx", speedMultiplier)))
                        Text("5x").accessibilityHidden(true)
                    }
                    Text(String(format: "%.1fx", speedMultiplier))
                        .font(.footnote).foregroundColor(.secondary)
                }

                Section("Sentence Pause") {
                    HStack {
                        Text("0").accessibilityHidden(true)
                        Slider(value: $sentencePause, in: 0...2000, step: 100)
                            .accessibilityLabel("Sentence pause")
                            .accessibilityValue(Text("\(Int(sentencePause)) ms"))
                        Text("2000").accessibilityHidden(true)
                    }
                    Text("\(Int(sentencePause)) ms")
                        .font(.footnote).foregroundColor(.secondary)
                }

                // MARK: Test
                Section("Test") {
                    TextField("Text to speak", text: $testText)
                        .accessibilityLabel("Test text")
                    Button(isSpeaking ? "Stop" : "Speak") {
                        if isSpeaking {
                            synth.stopSpeaking(at: .immediate)
                            isSpeaking = false
                        } else {
                            speakTest()
                        }
                    }
                    .accessibilityLabel(isSpeaking ? "Stop speaking" : "Speak test text")
                }

                // MARK: Instructions
                Section("How to use in VoiceOver") {
                    Text("1. Open VoiceOver Utility (VO + F8)")
                    Text("2. Go to Speech → Additional Voices")
                    Text("3. Click + and find Ukrainian")
                    Text("4. Select Anatol, Marianna or other voice")
                }
            }
        }
        .frame(minWidth: 420, minHeight: 600)
    }

    private func voiceRow(_ name: String, id: String, lang: String) -> some View {
        HStack {
            Image(systemName: "person.wave.2.fill").foregroundColor(.accentColor)
            VStack(alignment: .leading) {
                Text(name).fontWeight(.medium)
                Text(lang).font(.caption).foregroundColor(.secondary)
            }
            Spacer()
            Button("Test") { speakVoice(name: name, id: id, lang: lang) }
                .buttonStyle(.bordered)
                .accessibilityLabel("Test voice \(name)")
        }
    }

    private func speakTest() {
        guard let voice = AVSpeechSynthesisVoice(language: "uk-UA") else { return }
        let utt = AVSpeechUtterance(string: testText)
        utt.voice = voice
        utt.rate = Float(rate) * Float(speedMultiplier) * 0.5
        utt.volume = Float(volume)
        isSpeaking = true
        synth.speak(utt)
        DispatchQueue.main.asyncAfter(deadline: .now() + 5) { isSpeaking = false }
    }

    private func speakVoice(name: String, id: String, lang: String) {
        let utt = AVSpeechUtterance(string: "Hello, I am \(name)")
        utt.voice = AVSpeechSynthesisVoice(language: lang)
        utt.rate = Float(rate) * 0.5
        utt.volume = Float(volume)
        synth.speak(utt)
    }
}
