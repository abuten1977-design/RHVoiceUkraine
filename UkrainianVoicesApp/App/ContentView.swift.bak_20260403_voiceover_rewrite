import SwiftUI
import AVFoundation

private let appGroup = "group.rhvoice.UkrainianVoices.shared"
private let defaults = UserDefaults(suiteName: appGroup) ?? .standard
private let enabledVoiceIdentifiersKey = "enabledVoiceIdentifiers"
private let selectedVoiceIdentifierKey = "selectedVoiceIdentifier"
private let defaultEnabledVoiceIdentifiers: Set<String> = [
    "com.rhvoice.UkrainianVoices.anatol",
    "com.rhvoice.UkrainianVoices.alan"
]
private let preferredLanguageOrder = ["Ukrainian", "English"]

private struct VoiceDefinition: Identifiable, Hashable {
    let name: String
    let identifier: String
    let language: String
    let sampleText: String

    var id: String { identifier }

    var languageTitle: String {
        switch language {
        case "uk-UA": return "Ukrainian"
        case "en-US": return "English"
        default: return language
        }
    }
}

private struct VoiceSettingsState: Equatable {
    var useCustomSettings = false
    var rate = 0.5
    var volume = 1.0
    var speedMultiplier = 1.0
    var sentencePause = 0.0
}

private let voiceCatalog: [VoiceDefinition] = [
    .init(name: "Anatol", identifier: "com.rhvoice.UkrainianVoices.anatol", language: "uk-UA", sampleText: "Привіт! Це тест голосу Анатол."),
    .init(name: "Marianna", identifier: "com.rhvoice.UkrainianVoices.marianna", language: "uk-UA", sampleText: "Привіт! Це тест голосу Маріанна."),
    .init(name: "Natalia", identifier: "com.rhvoice.UkrainianVoices.natalia", language: "uk-UA", sampleText: "Привіт! Це тест голосу Наталія."),
    .init(name: "Volodymyr", identifier: "com.rhvoice.UkrainianVoices.volodymyr", language: "uk-UA", sampleText: "Привіт! Це тест голосу Володимир."),
    .init(name: "Alan", identifier: "com.rhvoice.UkrainianVoices.alan", language: "en-US", sampleText: "Hello! This is a test of Alan voice."),
    .init(name: "Victoria", identifier: "com.rhvoice.UkrainianVoices.victoria", language: "en-US", sampleText: "Hello! This is a test of Victoria voice.")
]

struct ContentView: View {
    @AppStorage("rate", store: defaults) private var rate: Double = 0.5
    @AppStorage("volume", store: defaults) private var volume: Double = 1.0
    @AppStorage("speedMultiplier", store: defaults) private var speedMultiplier: Double = 1.0
    @AppStorage("sentencePause", store: defaults) private var sentencePause: Double = 0
    @AppStorage(selectedVoiceIdentifierKey, store: defaults) private var selectedVoiceIdentifier: String = "com.rhvoice.UkrainianVoices.anatol"

    @State private var testText = "Привіт! Це тест українського голосу."
    @State private var enabledVoiceIdentifiers: Set<String> = []
    @State private var voiceSettingsByIdentifier: [String: VoiceSettingsState] = [:]
    @State private var editingVoice: VoiceDefinition?
    @State private var isSpeaking = false
    @State private var statusMessage = ""
    @State private var expandedLanguages: Set<String> = ["Ukrainian", "English"]

    private let synth = AVSpeechSynthesizer()
    private let previewEngine = RHVoiceEngine()
    private let audioEngine = AVAudioEngine()
    private let playerNode = AVAudioPlayerNode()

    var body: some View {
        VStack(alignment: .leading, spacing: 0) {
            Text("Ukrainian Voices")
                .font(.largeTitle).bold()
                .padding([.horizontal, .top])
                .padding(.bottom, 8)

            List {
                Section("How to use") {
                    Text("Turn on the voices you want, press Apply voices to system, then preview and adjust them.")
                        .font(.footnote)
                        .foregroundColor(.secondary)
                    LabeledContent("Enabled voices", value: "\(enabledVoiceIdentifiers.count)")
                    LabeledContent("Current preview voice", value: selectedVoice?.name ?? "None")
                    HStack {
                        Button("Apply voices to system") {
                            applyVoicesToSystem()
                        }
                        .buttonStyle(.borderedProminent)

                        Button("Reset to recommended voices") {
                            resetToRecommendedVoices()
                        }
                        .buttonStyle(.bordered)
                    }
                    .accessibilityHint("Updates the macOS voice list with the currently enabled RHVoice voices.")
                    if !statusMessage.isEmpty {
                        Text(statusMessage)
                            .font(.footnote)
                            .foregroundColor(.secondary)
                    }
                }

                Section("Languages") {
                    ForEach(groupedVoices, id: \.0) { language, voices in
                        DisclosureGroup(isExpanded: disclosureBinding(for: language)) {
                            VStack(alignment: .leading, spacing: 12) {
                                ForEach(voices) { voice in
                                    voiceRow(voice)
                                }
                            }
                            .padding(.top, 8)
                        } label: {
                            HStack {
                                Text(language)
                                    .font(.headline)
                                Spacer()
                                Text("\(enabledCount(for: voices)) enabled")
                                    .font(.caption)
                                    .foregroundColor(.secondary)
                            }
                        }
                    }
                }

                Section("Preview") {
                    if enabledVoices.isEmpty {
                        Text("Turn on at least one voice in the Languages section.")
                            .foregroundColor(.secondary)
                    } else {
                        Picker("Preview voice", selection: $selectedVoiceIdentifier) {
                            ForEach(enabledVoices) { voice in
                                Text("\(voice.name) (\(voice.languageTitle))")
                                    .tag(voice.identifier)
                            }
                        }
                        .pickerStyle(.menu)
                        .accessibilityHint("Chooses which enabled voice is used for preview and custom text playback.")
                    }

                    TextField("Text to speak", text: $testText)
                        .accessibilityHint("Enter custom text for the selected preview voice.")

                    HStack {
                        Button(isSpeaking ? "Stop preview" : "Preview custom text") {
                            isSpeaking ? stopSpeaking() : previewSelectedVoice()
                        }
                        .buttonStyle(.borderedProminent)

                        Button("Use sample text") {
                            if let selectedVoice {
                                testText = selectedVoice.sampleText
                            }
                        }
                        .buttonStyle(.bordered)
                    }
                }

                Section("General settings for all voices") {
                    settingsSliders(
                        rate: $rate,
                        volume: $volume,
                        speedMultiplier: $speedMultiplier,
                        sentencePause: $sentencePause,
                        prefix: "General"
                    )
                }
            }
        }
        .frame(minWidth: 700, minHeight: 820)
        .onAppear(perform: loadState)
        .sheet(item: $editingVoice) { voice in
            VoiceSettingsSheet(
                voice: voice,
                settings: Binding(
                    get: { settings(for: voice) },
                    set: { updateSettings($0, for: voice.identifier) }
                )
            )
        }
    }

    private var groupedVoices: [(String, [VoiceDefinition])] {
        Dictionary(grouping: voiceCatalog, by: { $0.languageTitle })
            .sorted { lhs, rhs in
                (preferredLanguageOrder.firstIndex(of: lhs.key) ?? preferredLanguageOrder.count) <
                (preferredLanguageOrder.firstIndex(of: rhs.key) ?? preferredLanguageOrder.count)
            }
    }

    private var enabledVoices: [VoiceDefinition] {
        voiceCatalog.filter { enabledVoiceIdentifiers.contains($0.identifier) }
    }

    private var selectedVoice: VoiceDefinition? {
        voiceCatalog.first(where: { $0.identifier == selectedVoiceIdentifier })
    }

    private func enabledCount(for voices: [VoiceDefinition]) -> Int {
        voices.filter { enabledVoiceIdentifiers.contains($0.identifier) }.count
    }

    private func disclosureBinding(for language: String) -> Binding<Bool> {
        Binding(
            get: { expandedLanguages.contains(language) },
            set: { expanded in
                if expanded {
                    expandedLanguages.insert(language)
                } else {
                    expandedLanguages.remove(language)
                }
            }
        )
    }

    @ViewBuilder
    private func voiceRow(_ voice: VoiceDefinition) -> some View {
        let isEnabled = enabledVoiceIdentifiers.contains(voice.identifier)
        let voiceSettings = settings(for: voice)

        VStack(alignment: .leading, spacing: 8) {
            Toggle(isOn: binding(for: voice.identifier)) {
                VStack(alignment: .leading, spacing: 2) {
                    Text(voice.name)
                        .fontWeight(.medium)
                    Text(voice.languageTitle)
                        .font(.caption)
                        .foregroundColor(.secondary)
                }
            }
            .toggleStyle(.switch)
            .accessibilityLabel("\(voice.name), \(voice.languageTitle)")
            .accessibilityHint("Turns this voice on or off for system registration.")

            HStack {
                Button("Use") {
                    selectedVoiceIdentifier = voice.identifier
                    if !isEnabled {
                        enabledVoiceIdentifiers.insert(voice.identifier)
                        persistVoiceState()
                    }
                    statusMessage = "Selected \(voice.name) for preview."
                }
                .buttonStyle(.bordered)

                Button("Listen sample") {
                    ensureVoiceEnabled(voice)
                    selectedVoiceIdentifier = voice.identifier
                    previewVoice(voice, overrideText: voice.sampleText)
                }
                .buttonStyle(.bordered)

                Button(voiceSettings.useCustomSettings ? "Voice settings on" : "Voice settings") {
                    editingVoice = voice
                }
                .buttonStyle(.bordered)

                if selectedVoiceIdentifier == voice.identifier {
                    Text("Current preview voice")
                        .font(.caption)
                        .foregroundColor(.secondary)
                }
            }
        }
        .padding(.vertical, 4)
    }

    @ViewBuilder
    private func settingsSliders(
        rate: Binding<Double>,
        volume: Binding<Double>,
        speedMultiplier: Binding<Double>,
        sentencePause: Binding<Double>,
        prefix: String
    ) -> some View {
        sliderRow(title: "Speech rate", value: rate, range: 0...1, step: 0.05, valueText: String(format: "%.0f%%", rate.wrappedValue * 100), hint: "\(prefix) speech rate")
        sliderRow(title: "Volume", value: volume, range: 0...1, step: 0.05, valueText: String(format: "%.0f%%", volume.wrappedValue * 100), hint: "\(prefix) volume")
        sliderRow(title: "Speed multiplier", value: speedMultiplier, range: 1...5, step: 0.5, valueText: String(format: "%.1fx", speedMultiplier.wrappedValue), hint: "\(prefix) speed multiplier")
        sliderRow(title: "Sentence pause", value: sentencePause, range: 0...2000, step: 100, valueText: "\(Int(sentencePause.wrappedValue)) ms", hint: "\(prefix) sentence pause")
    }

    @ViewBuilder
    private func sliderRow(title: String, value: Binding<Double>, range: ClosedRange<Double>, step: Double, valueText: String, hint: String) -> some View {
        VStack(alignment: .leading, spacing: 6) {
            HStack {
                Text(title)
                Spacer()
                Text(valueText)
                    .foregroundColor(.secondary)
            }
            Slider(value: value, in: range, step: step)
                .accessibilityLabel(title)
                .accessibilityValue(valueText)
                .accessibilityHint(hint)
        }
    }

    private func binding(for identifier: String) -> Binding<Bool> {
        Binding(
            get: { enabledVoiceIdentifiers.contains(identifier) },
            set: { enabled in
                if enabled {
                    enabledVoiceIdentifiers.insert(identifier)
                    if enabledVoiceIdentifiers.count == 1 {
                        selectedVoiceIdentifier = identifier
                    }
                } else {
                    enabledVoiceIdentifiers.remove(identifier)
                    if selectedVoiceIdentifier == identifier {
                        selectedVoiceIdentifier = enabledVoices.first?.identifier ?? defaultEnabledVoiceIdentifiers.first ?? identifier
                    }
                }
                persistVoiceState()
            }
        )
    }

    private func loadState() {
        loadVoiceState()
        loadPerVoiceSettings()
    }

    private func loadVoiceState() {
        if let stored = defaults.stringArray(forKey: enabledVoiceIdentifiersKey) {
            enabledVoiceIdentifiers = Set(stored)
        } else {
            enabledVoiceIdentifiers = defaultEnabledVoiceIdentifiers
            persistVoiceState()
        }

        if !enabledVoiceIdentifiers.contains(selectedVoiceIdentifier) {
            selectedVoiceIdentifier = enabledVoices.first?.identifier ?? "com.rhvoice.UkrainianVoices.anatol"
        }
    }

    private func persistVoiceState() {
        defaults.set(Array(enabledVoiceIdentifiers).sorted(), forKey: enabledVoiceIdentifiersKey)
        defaults.set(selectedVoiceIdentifier, forKey: selectedVoiceIdentifierKey)
    }

    private func loadPerVoiceSettings() {
        voiceSettingsByIdentifier = Dictionary(uniqueKeysWithValues: voiceCatalog.map { voice in
            (voice.identifier, storedSettings(for: voice.identifier))
        })
    }

    private func settings(for voice: VoiceDefinition) -> VoiceSettingsState {
        voiceSettingsByIdentifier[voice.identifier] ?? storedSettings(for: voice.identifier)
    }

    private func updateSettings(_ settings: VoiceSettingsState, for identifier: String) {
        voiceSettingsByIdentifier[identifier] = settings
        let prefix = voiceSettingsKeyPrefix(for: identifier)
        defaults.set(settings.useCustomSettings, forKey: "\(prefix).useCustomSettings")
        defaults.set(settings.rate, forKey: "\(prefix).rate")
        defaults.set(settings.volume, forKey: "\(prefix).volume")
        defaults.set(settings.speedMultiplier, forKey: "\(prefix).speedMultiplier")
        defaults.set(settings.sentencePause, forKey: "\(prefix).sentencePause")
    }

    private func storedSettings(for identifier: String) -> VoiceSettingsState {
        let prefix = voiceSettingsKeyPrefix(for: identifier)
        return VoiceSettingsState(
            useCustomSettings: defaults.object(forKey: "\(prefix).useCustomSettings") as? Bool ?? false,
            rate: defaults.object(forKey: "\(prefix).rate") as? Double ?? rate,
            volume: defaults.object(forKey: "\(prefix).volume") as? Double ?? volume,
            speedMultiplier: defaults.object(forKey: "\(prefix).speedMultiplier") as? Double ?? speedMultiplier,
            sentencePause: defaults.object(forKey: "\(prefix).sentencePause") as? Double ?? sentencePause
        )
    }

    private func voiceSettingsKeyPrefix(for identifier: String) -> String {
        "voiceSettings.\(identifier)"
    }

    private func ensureVoiceEnabled(_ voice: VoiceDefinition) {
        if !enabledVoiceIdentifiers.contains(voice.identifier) {
            enabledVoiceIdentifiers.insert(voice.identifier)
            persistVoiceState()
            AVSpeechSynthesisProviderVoice.updateSpeechVoices()
        }
    }

    private func previewSelectedVoice() {
        guard let voice = selectedVoice else {
            statusMessage = "Turn on and select a voice first."
            return
        }
        previewVoice(voice, overrideText: testText)
    }

    private func previewVoice(_ voice: VoiceDefinition, overrideText: String? = nil) {
        let text = (overrideText?.isEmpty == false) ? overrideText! : voice.sampleText
        let activeSettings = settings(for: voice)
        let appliedRate = activeSettings.useCustomSettings ? activeSettings.rate : rate
        let appliedVolume = activeSettings.useCustomSettings ? activeSettings.volume : volume
        let appliedSpeedMultiplier = activeSettings.useCustomSettings ? activeSettings.speedMultiplier : speedMultiplier
        let voiceName = voice.identifier.components(separatedBy: ".").last ?? voice.name.lowercased()

        guard let buffer = previewEngine.synthesize(
            text,
            voice: voiceName,
            rate: appliedRate * appliedSpeedMultiplier,
            volume: appliedVolume,
            pitch: 1.0
        ) else {
            statusMessage = "Could not synthesize sample for \(voice.name)."
            return
        }

        do {
            try playPreviewBuffer(buffer)
            isSpeaking = true
            statusMessage = "Previewing \(voice.name)."
        } catch {
            statusMessage = "Could not play sample for \(voice.name): \(error.localizedDescription)"
        }
    }

    private func stopSpeaking() {
        synth.stopSpeaking(at: .immediate)
        playerNode.stop()
        audioEngine.stop()
        isSpeaking = false
        statusMessage = "Preview stopped."
    }

    private func playPreviewBuffer(_ buffer: AVAudioPCMBuffer) throws {
        playerNode.stop()
        audioEngine.stop()
        audioEngine.reset()

        if playerNode.engine == nil {
            audioEngine.attach(playerNode)
        }

        let format = buffer.format
        audioEngine.connect(playerNode, to: audioEngine.mainMixerNode, format: format)
        try audioEngine.start()

        playerNode.scheduleBuffer(buffer, at: nil, options: .interrupts) {
            DispatchQueue.main.async {
                isSpeaking = false
                statusMessage = "Preview finished."
            }
        }
        playerNode.play()
    }

    private func resetToRecommendedVoices() {
        enabledVoiceIdentifiers = defaultEnabledVoiceIdentifiers
        selectedVoiceIdentifier = "com.rhvoice.UkrainianVoices.anatol"
        persistVoiceState()
        AVSpeechSynthesisProviderVoice.updateSpeechVoices()
        statusMessage = "Recommended voices restored: Anatol and Alan."
    }

    private func applyVoicesToSystem() {
        persistVoiceState()
        AVSpeechSynthesisProviderVoice.updateSpeechVoices()
        statusMessage = enabledVoiceIdentifiers.isEmpty
            ? "No RHVoice voices are enabled right now."
            : "System voice list updated. Enabled: \(enabledVoiceIdentifiers.count)."
    }
}

private struct VoiceSettingsSheet: View {
    let voice: VoiceDefinition
    @Binding var settings: VoiceSettingsState
    @Environment(\.dismiss) private var dismiss

    var body: some View {
        NavigationStack {
            Form {
                Section {
                    Toggle("Use individual settings for this voice", isOn: $settings.useCustomSettings)
                }

                Section("Voice settings") {
                    if settings.useCustomSettings {
                        sliderRow(title: "Speech rate", value: $settings.rate, range: 0...1, step: 0.05, valueText: String(format: "%.0f%%", settings.rate * 100))
                        sliderRow(title: "Volume", value: $settings.volume, range: 0...1, step: 0.05, valueText: String(format: "%.0f%%", settings.volume * 100))
                        sliderRow(title: "Speed multiplier", value: $settings.speedMultiplier, range: 1...5, step: 0.5, valueText: String(format: "%.1fx", settings.speedMultiplier))
                        sliderRow(title: "Sentence pause", value: $settings.sentencePause, range: 0...2000, step: 100, valueText: "\(Int(settings.sentencePause)) ms")
                    } else {
                        Text("This voice will use the general settings below the main voice list.")
                            .foregroundColor(.secondary)
                    }
                }
            }
            .navigationTitle("\(voice.name) settings")
            .toolbar {
                ToolbarItem(placement: .confirmationAction) {
                    Button("Done") {
                        dismiss()
                    }
                }
            }
        }
        .frame(minWidth: 420, minHeight: 360)
    }

    @ViewBuilder
    private func sliderRow(title: String, value: Binding<Double>, range: ClosedRange<Double>, step: Double, valueText: String) -> some View {
        VStack(alignment: .leading, spacing: 6) {
            HStack {
                Text(title)
                Spacer()
                Text(valueText)
                    .foregroundColor(.secondary)
            }
            Slider(value: value, in: range, step: step)
                .accessibilityLabel(title)
                .accessibilityValue(valueText)
        }
    }
}